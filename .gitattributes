# Keep development-only files out of GitHub's release zips (the tag's "Source code"
# archive), which is what gets submitted to the REDCap External Module Repository.
/.github                        export-ignore
/.gitattributes                 export-ignore
/.gitignore                     export-ignore
/.release-please-manifest.json  export-ignore
/release-please-config.json     export-ignore
/composer.json                  export-ignore
/composer.lock                  export-ignore
/eslint.config.js               export-ignore
/phpunit*.xml                   export-ignore
/psalm.xml                      export-ignore
/stubs                          export-ignore
/tests                          export-ignore
